{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "noUnusedVars": "off",
    "noAccumulatingSpread": "off",
    "noCycle": "off",
    "noUnsafeArgument": "off",
    "noUnsafeAssignment": "off",
    "noUnsafeMemberAccess": "off",
    "noUnsafeReturn": "off",
    "noEmptyFile": "off",
    "noUnresolved": "off",
    "noNamedAsDefault": "warn",
    "noRedundantTypeConstituents": "off",
    "requireModuleSpecifiers": "off",
    "tripleSlashReference": "off",
    "sortImports": "off",
    "arrowBodyStyle": "off",
    "named": "off",
    "namespace": "off",
    "noNamedAsDefaultMember": "off",
    "noAnonymousDefaultExport": "off",
    "preferDefaultExport": "off",
    "noSelfImport": "off",
    "first": "off",
    "exportsPresence": "off",
    "extensions": "off",
    "funcStyle": "off",
    "reactHooks": "error"
  },
  "settings": {
    "react": {
      "version": "19"
    }
  }
}
