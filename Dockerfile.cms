FROM oven/bun:1.4.3 AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Source map upload happens at build time. Without the token the Sentry webpack
# plugin skips uploading rather than failing, so the build still succeeds.
# Stack traces in Sentry are just left minified.
ARG SENTRY_AUTH_TOKEN
ENV SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN
ARG SENTRY_ORG
ENV SENTRY_ORG=$SENTRY_ORG
ARG SENTRY_PROJECT
ENV SENTRY_PROJECT=$SENTRY_PROJECT

# Inlined into the client bundle, so they must be present during `next build`.
ARG NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ARG RAILWAY_GIT_COMMIT_SHA
ENV RAILWAY_GIT_COMMIT_SHA=$RAILWAY_GIT_COMMIT_SHA
# Same value under a NEXT_PUBLIC_ name so it survives into the browser bundle,
# which is the only way client-side events get tagged with a release.
ENV NEXT_PUBLIC_SENTRY_RELEASE=$RAILWAY_GIT_COMMIT_SHA

RUN apt-get update && apt-get -yqq --no-install-recommends install \
    build-essential \
    python3 \
    make \
    g++ \
    pkg-config \
    git \
    ca-certificates \
    libvips-dev \
    autoconf \
    automake \
    libtool \
    && rm -rf /var/lib/apt/lists/*
COPY bun.lock ./
# Carries `linker = "hoisted"`. Bun 1.4 defaults workspaces to isolated
# linking, where a package resolves only what it declares itself — so without
# this file the image installs a different dependency layout than every
# developer machine, and any package that has been quietly relying on a
# hoisted sibling's dependency fails here and nowhere else.
COPY bunfig.toml ./
COPY package.json ./
COPY turbo.json ./
# Varlock schemas: apps/cms/.env.schema imports the root schema, which must
# exist at build time for env resolution (and again at runtime, see below).
COPY .env.schema ./
COPY patches ./patches
COPY packages ./packages
COPY apps ./apps
COPY tooling ./tooling
RUN bun tooling/portable-lockfile.mjs && bun install --lockfile-only --ignore-scripts && bun install --ignore-scripts
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# next.config.ts reads this for both `deploymentId` and `generateBuildId`, and
# next.config is evaluated while the image builds, not when it runs. Railway
# exposes the variable to the container but Docker does not pass it into the
# build without an ARG, so without this it is undefined exactly where it is
# read: `generateBuildId` returns null and Next falls back to a fresh random
# build id each time, while an unset `deploymentId` leaves skew protection off.
#
# Declared here rather than beside the other build args because its value is
# new on every deploy, including a redeploy of an unchanged commit. Any layer
# below an ENV that always changes can never be reused, so putting it above
# `bun install` would reinstall system packages and dependencies every time.
ARG RAILWAY_DEPLOYMENT_ID
ENV RAILWAY_DEPLOYMENT_ID=$RAILWAY_DEPLOYMENT_ID
RUN bun turbo build --filter=@news-spend-media/cms...

FROM oven/bun:1.4.3 AS runtime
WORKDIR /app
RUN apt-get update && apt-get -yqq --no-install-recommends install \
    ca-certificates \
    ffmpeg \
    libjemalloc2 \
    libvips \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2" /usr/local/lib/libjemalloc.so.2

# Every media upload runs six libvips pipelines at once (the original, four
# imageSizes and the blurhash decode). Under glibc malloc those native
# allocations fragment across per-thread arenas and the freed pages are never
# returned, so RSS steps up with each upload while the JS heap stays flat. The
# CMS climbed into its 1 GB limit and was OOM-killed repeatedly. jemalloc
# returns the pages: in a replay of the upload pipeline on this base image,
# growth over 20 uploads fell from +344 MB to +35 MB. sharp's own cache and
# concurrency settings made no difference. The symlink resolves the multiarch
# path so the same line works on amd64 and arm64.
ENV LD_PRELOAD=/usr/local/lib/libjemalloc.so.2

# sharp caps libvips at one thread under glibc but lifts the cap when it sees
# jemalloc, falling back to one thread per CPU — and Railway exposes 48. Payload
# resizes every imageSize concurrently, so an upload ran ~5 pipelines × 48
# threads and the per-upload peak rose from +228 MB to +296 MB, enough to get
# the 0.5 GB staging CMS OOM-killed on each upload. Two threads gave the lowest
# peak measured (+198 MB) and kept jemalloc returning pages (no drift over 12
# uploads); one thread measured the same within noise but is slower.
ENV VIPS_CONCURRENCY=2

COPY --from=builder /app/apps/cms/.next/standalone ./
COPY --from=builder /app/apps/cms/.next/static ./apps/cms/.next/static
COPY --from=builder /app/apps/cms/public ./apps/cms/public
# Varlock schemas for runtime env resolution (the @next/env override loads
# them on boot). Values still come from the platform environment — no .env
# files are copied into the runtime image on purpose.
COPY --from=builder /app/.env.schema ./.env.schema
COPY --from=builder /app/apps/cms/.env.schema ./apps/cms/.env.schema

EXPOSE 3000
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
CMD ["sh", "-c", "NODE_ENV=production bun apps/cms/server.js"]
