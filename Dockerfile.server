FROM oven/bun:1.3.11 AS builder

WORKDIR /app

COPY bun.lock ./
COPY package.json ./
COPY turbo.json ./
COPY patches ./patches
COPY packages ./packages
COPY apps/server ./apps/server
COPY tooling ./tooling

RUN bun install --lockfile-only --ignore-scripts && bun install --ignore-scripts

RUN bun turbo build --filter=@news-spend-media/server...

FROM oven/bun:1.3.11 AS runtime

WORKDIR /app

RUN apt-get update && apt-get -yqq --no-install-recommends install \
    libvips \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/bun.lock ./
COPY --from=builder /app/package.json ./
COPY --from=builder /app/turbo.json ./
COPY --from=builder /app/patches ./patches
COPY --from=builder /app/apps/server ./apps/server
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/tooling ./tooling

RUN bun install --ignore-scripts

EXPOSE 9000

ENV NODE_ENV=production
ENV PORT=9000
ENV HOSTNAME=0.0.0.0

CMD ["bun", "apps/server/dist"]
