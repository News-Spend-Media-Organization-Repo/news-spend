{
  "name": "payload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation\" next build",
    "ci": "bun run payload migrate && bun run build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "dotenvx run --convention=nextjs -- cross-env NODE_OPTIONS=\"--no-deprecation --inspect\" next dev",
    "dev:clean": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "dev:clean:turbo": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbo",
    "dev:turbo": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbo",
    "format": "oxfmt .",
    "format:fix": "oxfmt . --write",
    "generate:importmap": "payload generate:importmap",
    "generate:schema": "payload-graphql generate:schema",
    "generate:types": "payload generate:types",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --write",
    "payload": "payload",
    "standalone-script": "node ./src/scripts/standalone-script.js",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation\" next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@local/env": "workspace:*",
    "@local/payload": "workspace:*",
    "@local/svg": "workspace:*",
    "@local/ui": "workspace:*",
    "@payloadcms/db-mongodb": "^3.79.1",
    "@payloadcms/db-sqlite": "^3.79.1",
    "@payloadcms/graphql": "^3.79.1",
    "@payloadcms/live-preview-react": "^3.79.1",
    "@payloadcms/next": "^3.79.1",
    "@payloadcms/plugin-nested-docs": "^3.79.1",
    "@payloadcms/plugin-redirects": "^3.79.1",
    "@payloadcms/plugin-seo": "^3.79.1",
    "@payloadcms/richtext-lexical": "^3.79.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^0.0.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.10.0",
    "next": "^15.4.11",
    "payload": "^3.79.1",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.38.4",
    "@local/tailwind-config": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@local/types": "workspace:*",
    "@types/node": "^20.17.23",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
