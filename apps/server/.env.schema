# API server (Bun) env schema.
#
# Runtime: Bun. Launch through `varlock run` (see package.json scripts) so the
# resolved env is in place before Bun starts, and add `import 'varlock/auto-load'`
# at the entry point for ENV-proxy access, log redaction and leak detection.
# Bun's own automatic `.env` loading is disabled in the root bunfig.toml.
# See https://varlock.dev/integrations/bun/
#
# @defaultSensitive=false
# @defaultRequired=false
# ---

# Shared keys owned by the repo root. Importing the directory also merges the
# root `.env*` files; this package's own files win on conflict.
# See https://varlock.dev/guides/import/
# @import(../../, pick=[APP_ENV, NODE_ENV, DATABASE_URI, DATABASE_URL, REDIS_URL, CORS_ORIGIN, APP_URL, PAYLOAD_PUBLIC_SERVER_URL, PORT, LOG_LEVEL, MEMORY_SAMPLE_INTERVAL_MS, MODERATION_ALERT_EMAILS, NEWS_ANALYTICS_RETENTION_DAYS, SENTRY_DSN, SENTRY_ENABLED, SENTRY_TRACES_SAMPLE_RATE, RAILWAY_PUBLIC_DOMAIN, RAILWAY_ENVIRONMENT, RAILWAY_GIT_COMMIT_SHA, RELOADLY_ENV, RELOADLY_CLIENT_ID, RELOADLY_CLIENT_SECRET, RELOADLY_WEBHOOK_SECRET, DIDIT_API_KEY, DIDIT_WORKFLOW_ID, DIDIT_WEBHOOK_SECRET, DIDIT_BASE_URL, DIDIT_CALLBACK_URL, PAYLOAD_SECRET, RESEND_API_KEY, RESEND_DEFAULT_FROM_ADDRESS, RESEND_DEFAULT_FROM_NAME, SMTP_USER_FROM])
# ---

# Drizzle/Auth database URL. Re-declared to require it in production.
# @sensitive
# @required=forEnv(production)
# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Better Auth. Required in production.
# @sensitive
# @required=forEnv(production)
BETTER_AUTH_SECRET=
# @type=url(noTrailingSlash=true)
# @required=forEnv(production)
BETTER_AUTH_URL=

# --- App behaviour ---

# Floor for the native build version (e.g. "2.6.0"). Unset = feature off.
# @example="2.6.0"
MIN_APP_VERSION=

# @type=number(min=1)
TRENDING_INTERVAL_MINUTES=
# @type=number(min=1)
VIEW_DEDUPE_TTL_SECONDS=

# --- Survey / offer providers (all optional; a missing provider is disabled) ---

# Provider IDs are opaque strings; keep them strings so comparisons match.
# @type=string
CPX_APP_ID=
# @sensitive
CPX_SECURE_HASH=
# @sensitive
RAPIDO_API_KEY=
# Provider IDs are opaque strings; keep them strings so comparisons match.
# @type=string
RAPIDO_APP_ID=
# @sensitive
RAPIDO_SECURE_HASH=
# @sensitive
THEOREM_API_KEY=
# @type=url(noTrailingSlash=true)
THEOREM_REACH_URL=
# Public URL TheoremReach calls, exactly as configured in its dashboard. The
# request's own host is internal behind Railway, and the signature covers it.
# @type=url(noTrailingSlash=true)
THEOREM_CALLBACK_BASE_URL=

# Ayet Studios offers.
# @type=string
AYET_ADSLOT_ID=
# @sensitive
AYET_API_KEY=

# Segment webhook HMAC secret.
# @sensitive
SEGMENT_WEBHOOK_SECRET=
