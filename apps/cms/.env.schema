# CMS (Next.js + Payload) env schema.
#
# Framework integration: @varlock/nextjs-integration, a drop-in replacement
# for Next.js's internal @next/env loader plus a config plugin.
# See https://varlock.dev/integrations/nextjs/
#
# NEXT_RUNTIME is injected by Next.js itself, not project config.
# @auditIgnoreKeys(NEXT_RUNTIME)
#
# @defaultSensitive=false
# @defaultRequired=false
# ---

# Shared keys owned by the repo root. Importing the directory also merges the
# root `.env*` files; this package's own files win on conflict.
# See https://varlock.dev/guides/import/
# @import(../../, pick=[APP_ENV, NODE_ENV, DATABASE_URI, APP_URL, PAYLOAD_PUBLIC_SERVER_URL, LOG_LEVEL, MEMORY_SAMPLE_INTERVAL_MS, MODERATION_ALERT_EMAILS, NEWS_ANALYTICS_RETENTION_DAYS, SENTRY_DSN, SENTRY_ENABLED, SENTRY_TRACES_SAMPLE_RATE, SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN, NEXT_PUBLIC_SENTRY_RELEASE, RAILWAY_PUBLIC_DOMAIN, RAILWAY_ENVIRONMENT, RAILWAY_GIT_COMMIT_SHA, RAILWAY_DEPLOYMENT_ID, RELOADLY_ENV, RELOADLY_CLIENT_ID, RELOADLY_CLIENT_SECRET, DIDIT_API_KEY, DIDIT_WORKFLOW_ID, DIDIT_WEBHOOK_SECRET, DIDIT_BASE_URL, DIDIT_CALLBACK_URL, PAYLOAD_SECRET, RESEND_API_KEY, RESEND_DEFAULT_FROM_ADDRESS, RESEND_DEFAULT_FROM_NAME, SMTP_USER_FROM, SFTP_HOST, SFTP_USERNAME, SFTP_PASSWORD])
# ---

# Primary database. Re-declared to require it: the CMS cannot boot without it.
# @sensitive
# @required=forEnv(production)
# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URI=

# Public API base URL, inlined into the client bundle at build time, so it
# must be present as a Docker build arg (see Dockerfile.cms).
# @type=url(noTrailingSlash=true)
# @required
NEXT_PUBLIC_API_URL=

# Client-side env label (local | staging | production).
# @type=enum(local, staging, production)
NEXT_PUBLIC_APP_ENV=local

# Where the admin panel thinks Payload lives (client bundle).
# @type=url(noTrailingSlash=true)
NEXT_PUBLIC_PAYLOAD_URL=

# Canonical site URL for SEO/metadata. No default: set it per environment.
# @type=url(noTrailingSlash=true)
# @example="https://newsspend.com"
NEXT_PUBLIC_SITE_URL=

# Client-safe Sentry overrides (each falls back to its server-side twin).
# @sensitive=false
NEXT_PUBLIC_SENTRY_DSN=
# @type=boolean
NEXT_PUBLIC_SENTRY_ENABLED=
# @type=number(min=0, max=1)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Revalidation endpoint secret (server-only).
# @sensitive
# @required=forEnv(production)
NEXT_PRIVATE_REVALIDATION_KEY=

# Payload job workers run inside this process unless RUN_JOBS=false.
# @type=boolean
RUN_JOBS=

# Cap for the Postgres pool on small containers. Unset = adapter default.
# @type=number(min=1)
PG_POOL_MAX=

# --- Legacy keys (no code reads these; kept so committed files validate) ---
# Superseded by DATABASE_URI / PAYLOAD_SECRET / NEXT_PRIVATE_REVALIDATION_KEY.
PAYLOAD_PRIVATE_DATABASE_URI=
PAYLOAD_PRIVATE_DATABASE_ENGINE=
PAYLOAD_PRIVATE_SECRET=
PAYLOAD_PRIVATE_REVALIDATION_KEY=
