{
  "name": "astro",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "dotenvx run --convention=nextjs -- cross-env NODE_OPTIONS=\"--no-deprecation --inspect\" astro dev --host 0.0.0.0",
    "format": "biome check .",
    "format:fix": "biome check . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "preview": "astro preview",
    "start": "astro dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.1.2",
    "@astrojs/react": "4.1.2",
    "@astrojs/tailwind": "^5.1.5",
    "@astrojs/ts-plugin": "^1.10.4",
    "@dotenvx/dotenvx": "^1.38.4",
    "@local/env": "workspace:*",
    "@local/payload": "workspace:*",
    "@local/tailwind-config": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@local/types": "workspace:*",
    "@types/node": "^20.17.23",
    "astro": "^5.4.2",
    "cross-env": "^7.0.3",
    "payload": "^3.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-image-crop": "10.1.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
