# Native (Expo) env schema.
#
# Framework integration: @varlock/expo-integration. A Babel plugin replaces
# ENV.xxx references to non-sensitive items at compile time, and a Metro
# wrapper initialises the ENV proxy at bundle time. Sensitive values are never
# inlined into the JS bundle. See https://varlock.dev/integrations/expo/
#
# NOTE: EAS build profiles only inline the env vars EAS knows about. Anything
# marked required here must also be set as an EAS environment variable (or in
# the profile's `env` block), or the EAS bundle step fails by design. Plain
# `.env` values apply to local dev builds only.
#
# @defaultSensitive=false
# @defaultRequired=false
# ---

# @import(../../, pick=[APP_ENV, NODE_ENV, SENTRY_AUTH_TOKEN])
# ---

# API base URL inlined into the JS bundle. REQUIRED in production: without it
# the app cannot name its API (getBaseUrl throws at startup). Must be set as
# an EAS environment variable for `eas build` / `eas update --environment`.
# @type=url(noTrailingSlash=true)
# @required=forEnv(production)
# @example="https://api.newsspend.com"
EXPO_PUBLIC_API_URL=

# Detour (deferred deep links). Required: linking breaks without them.
# Client-bundled by design (read at runtime in the app): these ship inside
# the JS bundle, so they cannot be secrets. Restrict them in the Detour
# dashboard (bundle ID / app attestation) instead of trying to hide them.
# @sensitive=false
# @required
EXPO_PUBLIC_DETOUR_API_KEY=
# @sensitive=false
# @required
EXPO_PUBLIC_DETOUR_APP_ID=

# Set to "1" by the `screenshots` EAS profile to force deterministic fixtures.
EXPO_PUBLIC_SCREENSHOT_MODE=

# Build variant, set by each eas.json profile (and by local `.env` for dev).
# Baked into the manifest; drives channel/variant logic, never a secret.
# @type=enum(development, beta, preview, production)
APP_VARIANT=development

# OTA urgency baked into a published update's manifest ("optional" default).
# @type=enum(optional, mandatory)
UPDATE_PRIORITY=optional
