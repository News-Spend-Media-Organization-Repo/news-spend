{
  "name": "@local/payload",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./access/*": "./src/access/*/index.ts",
    "./blocks": "./src/blocks/index.ts",
    "./blocks/*": "./src/blocks/*/index.ts",
    "./blocks/*/Component": "./src/blocks/*/Component.tsx",
    "./collections/*": "./src/collections/*/index.ts",
    "./components/*": "./src/components/*/index.ts",
    "./fields/*": "./src/fields/*/index.ts",
    "./globals/*": "./src/globals/*/index.ts",
    "./helpers/*": "./src/helpers/*/index.ts",
    "./hooks/*": "./src/hooks/*/index.ts",
    "./plugins/*": "./src/plugins/*/index.ts",
    "./payload-types": "./src/payload.types.ts",
    "./payload-config": "./src/payload.config.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules bun.lockb",
    "format": "oxfmt .",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --write",
    "generate:types": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@local/env": "workspace:*",
    "@local/svg": "workspace:*",
    "@local/ui": "workspace:*",
    "@local/utils": "workspace:*",
    "@payloadcms/db-mongodb": "^3.79.1",
    "@payloadcms/graphql": "^3.79.1",
    "@payloadcms/live-preview-react": "^3.79.1",
    "@payloadcms/plugin-nested-docs": "^3.79.1",
    "@payloadcms/plugin-redirects": "^3.79.1",
    "@payloadcms/plugin-seo": "^3.79.1",
    "@payloadcms/richtext-lexical": "^3.79.1",
    "@payloadcms/ui": "^3.79.1",
    "lexical": "0.20.0",
    "next": "^15.4.11",
    "payload": "^3.79.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "ts-pattern": "^5.6.2"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@local/types": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.2"
  },
  "watch": {
    "generate:types": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,tsx",
      "quiet": false
    }
  }
}
