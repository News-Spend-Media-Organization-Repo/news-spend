{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "paths": {
      "@news-spend-media/ui/*": ["src/components/*/index.ts"],
      "@news-spend-media/ui/cn": ["src/utils/cn/index.ts"],
      "@news-spend-media/ui/hooks/*": ["src/hooks/*/index.ts"],
      "@news-spend-media/ui/types/*": ["src/types/*/index.ts"],
      "@news-spend-media/ui/utils/*": ["src/utils/*/index.ts"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "strictNullChecks": true
  },
  "exclude": ["node_modules"],
  "extends": "@news-spend-media/tsconfig/internal-package.json"
}
