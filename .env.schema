# Shared Varlock config for the news-spend monorepo.
#
# Layout: one `.env.schema` per project, shared keys owned here. Each app
# imports only what it needs, e.g. in `apps/cms/.env.schema`:
#
#   # @import(../../, pick=[APP_ENV, DATABASE_URI, REDIS_URL])
#
# Importing the directory (not just this file) also merges the root `.env*`
# files, with the importing package's own files winning.
# See https://varlock.dev/guides/monorepos/ and https://varlock.dev/guides/import/
#
# @currentEnv=$APP_ENV
# @defaultSensitive=false
# @defaultRequired=false
# ---

# Which environment to load (`.env.[APP_ENV]` files) and what `forEnv(...)`
# conditions match on. Must never be sensitive: the value is echoed by
# tooling everywhere, and redacting it would rewrite the env name in all output.
# Railway / EAS: set APP_ENV=production in each production service so
# production-only requirements are enforced at boot.
# @type=enum(development, test, staging, preview, production, local)
APP_ENV=development

# Standard runtime flag. Kept in sync with APP_ENV by convention, not by code.
# @type=enum(development, production, test)
NODE_ENV=development

# --- Shared infrastructure ---

# Primary Postgres connection string, used by the CMS and the API server.
# Required in production; local dev provides it via each app's own `.env`.
# @sensitive
# @required=forEnv(production)
# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URI=

# Second Postgres URL (Drizzle / auth flows). Required in production.
# @sensitive
# @required=forEnv(production)
# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Redis. Absent = single-node mode (in-memory rate limits, no pub/sub).
# @sensitive
# @type=url(allowedProtocols=[redis, rediss])
REDIS_URL=

# Allowed browser/app origin for the API server (comma handling lives in code).
# @example="https://cms.newsspend.com"
CORS_ORIGIN=

# Public base URL of the web surface. Used for email links and payload fallbacks.
# @type=url(noTrailingSlash=true)
APP_URL=

# Public base URL of the Payload server, used the same way as APP_URL.
# @type=url(noTrailingSlash=true)
PAYLOAD_PUBLIC_SERVER_URL=

# Port the API server listens on.
# @type=port
# @example=9000
PORT=

# Logging verbosity, read by @news-spend-media/logger.
# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=

# Interval for the server's periodic memory sample. 0 disables it.
# @type=number(min=0)
# @example=900000
MEMORY_SAMPLE_INTERVAL_MS=

# Extra moderation-alert recipients, comma-separated. Merged with settings.
# @type=array(email)
MODERATION_ALERT_EMAILS=

# Retention window for the news-analytics prune task.
# @type=number(min=1)
NEWS_ANALYTICS_RETENTION_DAYS=

# Test-only database URL (analytics integration tests).
# @type=url(allowedProtocols=[postgres, postgresql])
TEST_DATABASE_URI=

# --- Sentry (shared) ---

# Not a secret: a DSN only grants the ability to send events in. The apps
# also ship hardcoded fallback DSNs, so this is purely an override.
# @sensitive=false
SENTRY_DSN=

# "true" opts local dev into reporting; deployed envs report by default.
# @type=boolean
SENTRY_ENABLED=

# 0-1. Defaults to 0.2 in production, 1 elsewhere (see instrument/sentry.shared).
# @type=number(min=0, max=1)
SENTRY_TRACES_SAMPLE_RATE=

# Sourcemap upload config (build time). Slugs are identifiers, not secrets.
# @sensitive=false
SENTRY_ORG=
# @sensitive=false
SENTRY_PROJECT=
# Upload token. Handled gracefully when absent (upload skipped, build passes).
# @sensitive
SENTRY_AUTH_TOKEN=

# Commit SHA mapped onto a public name in Docker so browser events get a release.
NEXT_PUBLIC_SENTRY_RELEASE=

# --- Platform-injected (Railway) ---

# @type=domain
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_ENVIRONMENT=
RAILWAY_GIT_COMMIT_SHA=
RAILWAY_DEPLOYMENT_ID=

# --- Giveaway fulfilment (Reloadly) ---

# The audience decides whether a top-up is SIMULATED or sends REAL airtime.
# No default is set on purpose: production must choose explicitly, while
# local dev takes `sandbox` from the root `.env` and builds/CI skip
# enforcement (they run as a non-production APP_ENV).
# @required=forEnv(production)
# @type=enum(sandbox, live)
RELOADLY_ENV=

# @sensitive
# @required=forEnv(production)
RELOADLY_CLIENT_ID=
# @sensitive
# @required=forEnv(production)
RELOADLY_CLIENT_SECRET=

# The webhook signing key from the Reloadly dashboard, separate from
# RELOADLY_CLIENT_SECRET. The endpoint refuses callbacks without it.
# @sensitive
# @required=forEnv(production)
RELOADLY_WEBHOOK_SECRET=

# --- Identity verification (Didit) ---

# All three or nothing: the provider is treated as absent unless all are set.
# @sensitive
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# @sensitive
DIDIT_WEBHOOK_SECRET=
# Optional overrides; code ships defaults for both.
# @type=url(noTrailingSlash=true)
DIDIT_BASE_URL=
# @type=url(noTrailingSlash=true)
DIDIT_CALLBACK_URL=

# --- Backend-shared secrets ---

# Payload admin/API secret. Required in production.
# @sensitive
# @required=forEnv(production)
PAYLOAD_SECRET=

# Resend API key. Required in production (Payload email adapter + mail service).
# @sensitive
# @required=forEnv(production)
RESEND_API_KEY=
# @type=email
RESEND_DEFAULT_FROM_ADDRESS=
RESEND_DEFAULT_FROM_NAME=
# The "from" mailbox used by @news-spend-media/mail.
# @type=email
SMTP_USER_FROM=

# cPanel/SFTP media storage. Required in production (uploads break without it).
# @required=forEnv(production)
SFTP_HOST=
# @required=forEnv(production)
SFTP_USERNAME=
# @sensitive
# @required=forEnv(production)
SFTP_PASSWORD=
