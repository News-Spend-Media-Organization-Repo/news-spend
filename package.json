      "@orpc/standard-server-fetch": "^1.12.2",
      "better-auth": "^1.5.5",
      "@better-auth/expo": "^1.5.5",
      "dotenv": "^17.2.2",
      "zod": "^4.4.3",
      "vitest": "^2.1.8",
      "jose": "^5.9.6",
      "tailwindcss": "^3.4.17",
