{
  "name": "turbo-payload",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev",
    "format": "oxfmt .",
    "format:fix": "oxfmt --fix .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "storybook": "turbo storybook",
    "typecheck": "turbo typecheck --continue"
  },
  "devDependencies": {
    "@turbo/gen": "^2.4.4",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "ultracite": "7.3.2"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "packageManager": "bun@1.3.9"
}
